# Generated by tools/make-source-package.py; archive and build identity are pinned.
pkgname=libfprint-goodix-local
pkgver=@PKGVER@
pkgrel=1
pkgdesc='Experimental 27c6:55a2 libfprint, isolated under /opt/libfprint-goodix'
arch=('x86_64')
url='https://github.com/pjunak/libfprint'
license=('LGPL-2.1-or-later')
depends=('glib2' 'libgusb' 'openssl' 'python' 'pam' 'systemd-libs')
makedepends=('meson' 'ninja' 'pkgconf')
checkdepends=('cairo' 'dbus' 'python-gobject')
source=('libfprint-goodix-source.tar.gz')
sha256sums=('@SHA256@')
options=('!lto')

build() {
  meson setup "$srcdir/build" "$srcdir/libfprint-goodix" \
    --prefix=/opt/libfprint-goodix --libdir=lib \
    -Dbuild-id=@BUILD_ID@ -Dsigfm=disabled -Ddrivers=default \
    -Ddoc=false -Dintrospection=false -Dinstalled-tests=false \
    -Dudev_rules=disabled -Dudev_hwdb=disabled
  meson compile -C "$srcdir/build"
}

check() {
  meson test -C "$srcdir/build" --suite unit-tests --print-errorlogs
}

package() {
  DESTDIR="$pkgdir" meson install -C "$srcdir/build" --no-rebuild
  install -Dm755 "$srcdir/libfprint-goodix/tools/goodix-diagnose.py" \
    "$pkgdir/usr/bin/goodix-diagnose"
  install -Dm755 "$srcdir/libfprint-goodix/tools/collect-goodix.py" \
    "$pkgdir/usr/bin/goodix-collect"
  install -Dm755 "$srcdir/libfprint-goodix/tools/evaluate-recognition.py" \
    "$pkgdir/usr/bin/goodix-evaluate"
  install -Dm755 "$srcdir/libfprint-goodix/tools/import-goodix-trace.py" \
    "$pkgdir/usr/bin/goodix-import-trace"
  install -Dm755 "$srcdir/libfprint-goodix/tools/goodix-fingerprint-pam.py" \
    "$pkgdir/usr/bin/goodix-fingerprint-pam"
  install -Dm644 "$srcdir/libfprint-goodix/packaging/arch/goodix-fingerprint.hook" \
    "$pkgdir/usr/share/libalpm/hooks/goodix-fingerprint.hook"
  install -Dm644 "$srcdir/libfprint-goodix/packaging/arch/fprintd-goodix.conf.example" \
    "$pkgdir/usr/share/doc/$pkgname/fprintd-goodix.conf.example"
  install -Dm644 "$srcdir/libfprint-goodix/packaging/arch/README.md" \
    "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "$srcdir/libfprint-goodix/data/pam/plasmalogin-fingerprint.example" \
    "$pkgdir/usr/share/doc/$pkgname/data/pam/plasmalogin-fingerprint.example"
  install -Dm644 "$srcdir/libfprint-goodix/INSTALL_55a2.md" \
    "$pkgdir/usr/share/doc/$pkgname/INSTALL_55a2.md"
  for doc in GOODIX_VALIDATION.md GOODIX_55A2_DRIVER.md PAM_FPRINT_PARALLEL.md; do
    install -Dm644 "$srcdir/libfprint-goodix/doc/$doc" "$pkgdir/usr/share/doc/$pkgname/doc/$doc"
  done
  install -Dm644 "$srcdir/libfprint-goodix/README.md" "$pkgdir/usr/share/doc/$pkgname/README.project.md"
}
